    		add(menuItems);
    
    		// var tex = Paths.getSparrowAtlas('FNF_main_menu_assets');
    
    		optionTweens = new Map<FlxSprite, FlxTween>();
    
    		for (i in 0...optionShit.length)
    		{
    			var menuItem = new FlxTypedGroup<FlxSprite>();
